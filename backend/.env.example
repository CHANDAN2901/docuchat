# Local dev defaults to SQLite and http://localhost — override for production.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:3000
DATABASE_URL=sqlite:///./docuchat.db

# Vector store — a Qdrant Cloud cluster (or a local `docker run qdrant/qdrant` for dev)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=docuchat_chunks

OPENAI_MODEL=gpt-4.1-mini
# No OPENAI_API_KEY here — each user supplies their own from the browser (BYOK),
# sent per-request as the X-OpenAI-Key header. The backend never stores it.
